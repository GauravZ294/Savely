# Copy to .env and fill in. Never commit .env – this example file IS committed, so keep only placeholders here.

PORT=4000
HOST=0.0.0.0

# Where contact-form messages are sent
CONTACT_TO=allinoneapps12@gmail.com

# Gmail: turn on 2-Step Verification, then create an App Password (Google Account › Security › App passwords)
# and paste the 16-character password here. Any other SMTP provider works too.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# yt-dlp binary (must be installed on the server; ffmpeg is needed for MP4 merging and MP3)
YTDLP_PATH=yt-dlp
# Max file size yt-dlp will download, e.g. 2G / 500M (empty = unlimited)
MAX_FILESIZE=2G

# YouTube on the website (the Android app never downloads from YouTube). Set to false to switch it off.
ALLOW_YOUTUBE=true
# Servers/datacenter IPs usually get "Sign in to confirm you're not a bot" from YouTube. Export cookies from a
# logged-in browser (extension "Get cookies.txt LOCALLY", Netscape format) and point to the file here.
# Use a throwaway Google account – never your main one. Keep yt-dlp updated: `yt-dlp -U`.

# On Render: add youtube-cookies.txt as a Secret File, then use:
# YTDLP_COOKIES=/etc/secrets/youtube-cookies.txt
# See DEPLOY.md. Never put cookies in GitHub.
YTDLP_COOKIES=

# Play Store link shown everywhere on the site
PLAY_URL=https://play.google.com/store/apps/details?id=com.savely.videodownloader
